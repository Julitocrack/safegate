  <property name="styleSheet">
   <string notr="true">/* style.qss - Código QSS Completo para Login y Dashboard */

/* --- 1. ESTILO BASE DE LA APLICACIÓN --- */
QMainWindow, QDialog {
    background-color: #1e1e1e; /* Fondo muy oscuro principal */
    color: #e0e0e0; /* Texto base claro */
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 11pt;
}

/* --- 2. ESTILO PARA TÍTULOS Y ETIQUETAS --- */
QLabel {
    color: #cccccc;
}

/* Título principal (Usado en LoginWindow y MainWindow) */
QLabel#lbl_titulo { 
    color: #4CAF50; /* Acento verde para títulos */
    font-size: 24pt;
    font-weight: bold;
    padding-bottom: 15px;
}

/* Título de estado/acceso en el video feed */
QLabel#lbl_estado_acceso {
    font-size: 16pt;
    font-weight: bold;
    color: #00bcd4; /* Acento cian */
}

/* --- 3. ESTILO PARA WIDGETS DE LOGIN (QLineEdit) --- */
QLineEdit {
    background-color: #3c3c3c; /* Fondo de campo más oscuro */
    border: 2px solid #5a5a5a; 
    border-radius: 8px; 
    padding: 10px;
    color: #f0f0f0;
    font-size: 14pt;
    selection-background-color: #00bcd4;
}

QLineEdit:focus {
    border: 2px solid #4CAF50; /* Borde verde al enfocar */
}

/* --- 4. ESTILO PARA BOTONES (Login y MainWindow) --- */
/* Botón de Acceder (Login) y Registro Manual (Dashboard) */
QPushButton#btn_acceder, QPushButton#btn_registro_manual {
    background-color: #00bcd4; /* Fondo Cian Vibrante */
    color: #1e1e1e; 
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 14pt;
    font-weight: bold;
    min-height: 40px; 
}

QPushButton#btn_acceder:hover, QPushButton#btn_registro_manual:hover {
    background-color: #00a8b9;
}

QPushButton#btn_acceder:pressed, QPushButton#btn_registro_manual:pressed {
    background-color: #0093a3;
}


/* --- 5. ESTILOS ESPECÍFICOS DE MAINWINDOW --- */

/* Área de Video Feed (QLabel: video_feed_label) */
QLabel#video_feed_label {
    background-color: #000000; /* Fondo negro sólido para el feed */
    border: 3px solid #333333; 
    border-radius: 8px;
}

/* Tabla de Bitácora (QTableWidget: tabla_bitacora) */
QTableWidget#tabla_bitacora {
    background-color: #252526; /* Fondo de tabla más oscuro */
    border: 1px solid #444444;
    gridline-color: #383838; 
    color: #f0f0f0;
    selection-background-color: #4CAF50; /* Acento verde al seleccionar fila */
    selection-color: #1e1e1e; 
    font-size: 10pt;
}

/* Cabeceras de la tabla (QTableWidget) */
QHeaderView::section {
    background-color: #3a3a3a;
    color: #ffffff;
    padding: 5px;
    border: 1px solid #444444;
    font-weight: bold;
}

/* Scrollbars */
QScrollBar:vertical, QScrollBar:horizontal {
    border: none;
    background: #252526;
    width: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #555555;
    min-height: 20px;
    border-radius: 4px;
}</string>
