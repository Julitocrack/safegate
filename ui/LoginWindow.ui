  <property name="styleSheet">
   <string notr="true">/* style_claro.qss */

/* ESTILO BASE DE LA VENTANA (QMainWindow o QDialog) */
QMainWindow, QDialog {
    background-color: #f5f5f5; /* Fondo muy claro, casi blanco */
    color: #333333; /* Color de texto oscuro para legibilidad */
    font-family: 'Segoe UI', 'Helvetica', sans-serif;
    font-size: 13pt;
}

/* ESTILO PARA ETIQUETAS (Títulos) */
QLabel#lbl_titulo { /* Usa el nombre de objeto si lo asignaste */
    color: #0078d4; /* Color azul profesional para el título */
    font-size: 22pt;
    font-weight: 600; /* Semi-bold */
    padding-bottom: 15px;
}
QLabel {
    color: #555555;
    font-size: 14pt;
    font-weight: 500;
}

/* ESTILO PARA CAMPOS DE ENTRADA DE TEXTO (QLineEdit) */
QLineEdit {
    background-color: #ffffff; /* Fondo blanco puro */
    border: 1px solid #c8c8c8; /* Borde gris muy suave */
    border-radius: 5px; 
    padding: 8px;
    color: #333333;
    font-size: 14pt;
    selection-background-color: #add8e6; /* Azul claro para la selección */
}

QLineEdit:focus {
    border: 2px solid #0078d4; /* Borde azul al enfocar */
}

/* ESTILO PARA EL BOTÓN DE ACCESO (QPushButton) */
QPushButton#btn_acceder {
    background-color: #0078d4; /* Color principal de acción (azul) */
    color: #ffffff; /* Texto blanco */
    border: none;
    border-radius: 5px;
    padding: 10px 20px;
    font-size: 15pt;
    font-weight: bold;
}

QPushButton#btn_acceder:hover {
    background-color: #0056b3; /* Un azul ligeramente más oscuro al pasar el ratón */
}

QPushButton#btn_acceder:pressed {
    background-color: #004080; /* Azul oscuro al presionar */
}</string>
