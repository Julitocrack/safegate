  <property name="styleSheet">
   <string notr="true">QMainWindow {
    /* Fondo principal: Degradado oscuro y futurista */
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(30, 30, 40, 255), stop:1 rgba(15, 15, 25, 255));
    border: 1px solid #00c0ff; /* Borde sutil azul eléctrico */
    border-radius: 10px;
}

/* Título de la aplicación */
QLabel#lbl_titulo {
    color: #00e0ff; /* Azul eléctrico brillante */
    font: bold 30pt &quot;Segoe UI&quot;, &quot;Arial&quot;; /* Fuente moderna */
    border-bottom: 2px solid #00aaff; /* Línea de acento */
    padding-bottom: 15px;
    margin-bottom: 20px;
    qproperty-alignment: AlignCenter; /* Centrar texto */
}

/* Etiquetas de Usuario/Contraseña */
QLabel {
    color: #a0a0a0; /* Gris claro */
    font: 14pt &quot;Segoe UI&quot;;
    font-weight: bold;
    margin-bottom: 5px;
}

/* Campos de entrada (Usuario y Contraseña) */
QLineEdit {
    background-color: rgba(60, 60, 80, 0.7); /* Fondo semi-transparente oscuro */
    color: #e0e0e0; /* Texto gris muy claro */
    border: 1px solid #0080ff; /* Borde azul suave */
    padding: 12px;
    border-radius: 8px;
    font-size: 15pt;
    selection-background-color: #00e0ff; /* Resaltado de selección */
}

/* Foco en el campo seleccionado */
QLineEdit:focus {
    border: 2px solid #00c0ff; /* Borde azul eléctrico al editar */
    background-color: rgba(70, 70, 90, 0.9); /* Más opaco */
}

/* Botones: Ingresar */
QPushButton#btn_ingresar {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #0080ff, stop:1 #00c0ff); /* Degradado azul */
    color: white;
    font: bold 16pt &quot;Segoe UI&quot;;
    padding: 15px;
    border: none;
    border-radius: 10px;
    min-width: 180px;
    letter-spacing: 1px; /* Espaciado de letras */
    box-shadow: 0px 5px 10px rgba(0, 192, 255, 0.4); /* Sombra brillante */
}

/* Efecto Hover para Botón Ingresar */
QPushButton#btn_ingresar:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #00aaff, stop:1 #00ffff);
    box-shadow: 0px 7px 15px rgba(0, 192, 255, 0.6);
}

/* Botones: Registrar */
QPushButton#btn_registrar {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #606060, stop:1 #808080); /* Degradado gris */
    color: #e0e0e0;
    font: 14pt &quot;Segoe UI&quot;;
    padding: 12px;
    border: none;
    border-radius: 10px;
    min-width: 180px;
    letter-spacing: 0.5px;
}

/* Efecto Hover para Botón Registrar */
QPushButton#btn_registrar:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #707070, stop:1 #909090);
    color: white;
}

/* Etiqueta de error */
QLabel#lbl_error {
    color: #ff4040; /* Rojo brillante para errores */
    font: bold 12pt &quot;Segoe UI&quot;;
    margin-top: 15px;
    qproperty-alignment: AlignCenter;
}</string>
