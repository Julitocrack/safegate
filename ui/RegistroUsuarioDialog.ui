  <property name="styleSheet">
   <string notr="true">/* --- ESTILO PARA EL DIÁLOGO GENERAL --- */
QDialog {
    background-color: #2b2b2b; /* Fondo oscuro (más claro que la MainWindow) */
    color: #e0e0e0;
}

/* --- TÍTULOS Y ETIQUETAS --- */
QLabel {
    color: #cccccc;
    font-size: 12pt;
    font-weight: 500;
}

QLabel#lbl_titulo_dialog { /* Título principal del Diálogo */
    color: #4CAF50; /* Acento verde para indicar acción/registro */
    font-size: 18pt;
    font-weight: bold;
    padding-bottom: 10px;
}

/* --- CAMPOS DE ENTRADA (QLineEdit) --- */
QLineEdit {
    background-color: #3c3c3c; 
    border: 2px solid #5a5a5a; 
    border-radius: 6px; 
    padding: 8px;
    color: #f0f0f0;
    font-size: 12pt;
    selection-background-color: #00bcd4; /* Cian */
}

QLineEdit:focus {
    border: 2px solid #4CAF50; /* Verde al enfocar */
}

/* --- ÁREA DE FOTO/ESCÁNER (scan_foto_label) --- */
QLabel#scan_foto_label {
    background-color: #1a1a1a; /* Fondo muy oscuro para el área de previsualización */
    border: 1px dashed #00bcd4; /* Borde cian punteado para indicar zona activa */
    border-radius: 8px;
    text-align: center;
    color: #999999;
    padding: 10px;
}

/* --- BOTONES DE ACCIÓN --- */

/* Botón Registrar (Acción Positiva: Verde) */
QPushButton#btn_registrar_visita {
    background-color: #4CAF50; 
    color: #1e1e1e; 
    border: none;
    border-radius: 6px;
    padding: 5px 15px;
    font-size: 13pt;
    font-weight: bold;
}

QPushButton#btn_registrar_visita:hover {
    background-color: #43A047;
}

/* Botón Escanear ID (Acción de Proceso: Cian) */
QPushButton#btn_escanear_id {
    background-color: #00bcd4; 
    color: #1e1e1e;
    border: none;
    border-radius: 6px;
    padding: 10px 15px;
    font-size: 12pt;
    font-weight: bold;
}

QPushButton#btn_escanear_id:hover {
    background-color: #00a8b9;
}

/* Botón Cancelar (Acción Secundaria/Negativa: Gris Neutro) */
QPushButton#btn_cancelar {
    background-color: #5a5a5a; 
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 5px 15px;
    font-size: 13pt;
}

QPushButton#btn_cancelar:hover {
    background-color: #6a6a6a;
}</string>
