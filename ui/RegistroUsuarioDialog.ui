  <property name="styleSheet">
   <string notr="true">QDialog {
    /* FONDO: Degradado oscuro idéntico al Login */
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(30, 30, 40, 255), stop:1 rgba(15, 15, 25, 255));
    border: 1px solid #00c0ff; /* Borde sutil azul eléctrico (igual al Login) */
    border-radius: 10px;
}

/* Título del Diálogo (Idéntico al Login) */
QLabel#lbl_titulo { 
    color: #00e0ff; /* Azul eléctrico brillante */
    font: bold 22pt &quot;Segoe UI&quot;, &quot;Arial&quot;;
    border-bottom: 1px solid #00aaff;
    padding-bottom: 10px;
    margin-bottom: 20px;
    qproperty-alignment: AlignCenter;
}

/* Etiquetas de los campos (Idénticas al Login) */
QLabel {
    color: #a0a0a0; 
    font-size: 13pt;
    font-weight: bold;
    margin-bottom: 5px;
}

/* Campos de entrada (QLineEdit y QComboBox) - Idénticos al Login */
QLineEdit, QComboBox {
    background-color: rgba(60, 60, 80, 0.7); 
    color: #e0e0e0; 
    border: 1px solid #0080ff; 
    padding: 10px;
    border-radius: 6px;
    font-size: 14pt;
    selection-background-color: #00e0ff; 
}

/* Foco en el campo seleccionado */
QLineEdit:focus, QComboBox:focus {
    border: 2px solid #00c0ff; 
    background-color: rgba(70, 70, 90, 0.9); 
}

/* --- ESTILOS DE BOTONES FUNCIONALES (QDialogButtonBox) --- */

/* Estilo base de los botones del diálogo */
QDialogButtonBox QPushButton {
    color: white;
    font: bold 12pt &quot;Segoe UI&quot;;
    padding: 10px 20px;
    border-radius: 8px;
    border: none;
    letter-spacing: 0.8px;
    min-width: 120px;
}

/* 1. Botón REGISTRAR (Aceptación/OK) -&gt; AZUL ELÉCTRICO (Como el botón INGRESAR del Login) */
QDialogButtonBox QPushButton[text=&quot;Registrar&quot;] {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #0080ff, stop:1 #00c0ff); /* Degradado Azul */
    box-shadow: 0px 5px 10px rgba(0, 192, 255, 0.4); /* Sombra brillante */
    font-weight: bold; /* Destacar más */
}

QDialogButtonBox QPushButton[text=&quot;Registrar&quot;]:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #00aaff, stop:1 #00ffff);
}

/* 2. Botón CANCELAR (Rechazo/Cancel) -&gt; GRIS SUAVE (Similar al botón REGISTRAR del Login) */
QDialogButtonBox QPushButton[text=&quot;Cancelar&quot;] {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #606060, stop:1 #808080); /* Degradado Gris */
    color: #e0e0e0;
}

QDialogButtonBox QPushButton[text=&quot;Cancelar&quot;]:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #707070, stop:1 #909090);
}

/* Etiqueta de error */
QLabel#lbl_error_registro { 
    color: #ff4040; 
    font: bold 12pt &quot;Segoe UI&quot;;
    margin-top: 15px;
    qproperty-alignment: AlignCenter;
}</string>
