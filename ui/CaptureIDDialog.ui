  <property name="styleSheet">
   <string notr="true">/* --- ESTILO PARA EL DIÁLOGO DE CAPTURA (QDialog) --- */
QDialog {
    background-color: #2b2b2b; /* Fondo oscuro */
    color: #e0e0e0;
}

/* --- TÍTULO --- */
QLabel {
    color: #cccccc;
    font-size: 12pt;
    font-weight: 500;
}
/* Título principal de la ventana (Captura de Identificación) */
QLabel {
    color: #00bcd4; /* Cian para el título de proceso */
    font-size: 18pt;
    font-weight: bold;
    padding: 0px;
}

/* --- ÁREA DE VIDEO FEED (QLabel: capture_feed_label) --- */
/* Esta área es el widget central que recibe el video de la cámara */
QLabel {
    background-color: #000000; /* Fondo negro sólido para simular la cámara apagada */
    border: 3px solid #00bcd4; /* Borde cian para resaltar el área de trabajo */
    border-radius: 8px;
    text-align: center;
    color: #999999; /* Texto claro de placeholder */
}

/* --- BOTONES --- */
/* Botón Capturar (Acción Primaria: Verde) */
QPushButton#btn_tomar_foto {
    background-color: #4CAF50; /* Verde para la acción de guardar/confirmar */
    color: #1e1e1e; 
    border: none;
    border-radius: 6px;
    padding: 3px 15px;
    font-size: 14pt;
    font-weight: bold;
}

QPushButton#btn_tomar_foto:hover {
    background-color: #43A047;
}

/* Botón Cerrar (Acción Secundaria/Negativa: Gris) */
QPushButton#btn_cerrar {
    background-color: #5a5a5a; /* Gris neutro */
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 5px 15px;
    font-size: 14pt;
}

QPushButton#btn_cerrar:hover {
    background-color: #6a6a6a;
}</string>
